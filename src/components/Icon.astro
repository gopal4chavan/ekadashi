      '<path d="M12 10V2"/>' +
      '<path d="m4.93 10.93 1.41 1.41"/>' +
      '<path d="M2 18h2"/><path d="M20 18h2"/>' +
      '<path d="m19.07 10.93-1.41 1.41"/>' +
      '<path d="M22 22H2"/>' +
      '<path d="m16 6-4 4-4-4"/>' +
      '<path d="M16 18a4 4 0 0 0-8 0"/>',
  },
  moon: {
    viewBox: '0 0 24 24',
    strokeWidth: 1.8,
    markup: '<path d="M20 14.5A8.5 8.5 0 1 1 9.5 4 7 7 0 0 0 20 14.5z"/>',
