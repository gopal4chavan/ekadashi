---
/** Stroke icons aligned with theme-1 preview (Lucide + IconPark outline lotus). */
interface Props {
  name:
    | 'pin'
    | 'calendar'
    | 'calendar-clock'
    | 'clock'
    | 'sun'
    | 'sunrise'
    | 'sunset'
    | 'moon'
    | 'lotus'
    | 'crosshair'
    | 'info'
    | 'search'
    | 'chevron-down'
    | 'menu';
  class?: string;
  size?: number;
}

const { name, class: className = '', size = 20 } = Astro.props;

type IconDef = { viewBox: string; strokeWidth: number; markup: string; filled?: boolean };

const icons: Record<Props['name'], IconDef> = {
